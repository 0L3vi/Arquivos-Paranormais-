# Copie este arquivo para ".env" e ajuste.

PORT=3000
# 127.0.0.1 = só este computador abre o site.
# 0.0.0.0   = celular/iPad no mesmo Wi-Fi também abrem (exige APP_PASSWORD).
HOST=127.0.0.1

# Senha do site (obrigatória para o modo real)
APP_PASSWORD=

# Intervalo entre análises do robô (segundos) com dados reais
TICK_SECONDS=60
# Com dados simulados (sem internet), cada ciclo = 1 pregão acelerado
SIM_TICK_SECONDS=5

# ---- MODO REAL (dinheiro de verdade) ----
REAL_TRADING_ENABLED=false
MT5_BRIDGE_URL=http://127.0.0.1:5001
# Mesmo token configurado na ponte Python (bridge/mt5_bridge.py)
MT5_BRIDGE_TOKEN=
